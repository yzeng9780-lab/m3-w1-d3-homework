extends layout

block content
  aside#leftside
  aside#rightside
  #container
    include components/header.pug

    main
      aside#photos
        img(src='/images/chili.jpg', alt='White Chicken Chili', width='180')
      h2 Comments

      section#blogposts
        each post in posts
          include components/post.pug

    include components/footer.pug
